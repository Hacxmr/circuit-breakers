# Environment Configuration for Circuit Breaker + NBF-LLM

# LM STUDIO (Local Models) - No API key needed
# Default: http://localhost:1234/v1
# Uncomment to customize:
# LMSTUDIO_BASE_URL=http://localhost:1234/v1

# OLLAMA (Local Models) - No API key needed
# Default: http://localhost:11434/v1
# Uncomment to customize:
# OLLAMA_BASE_URL=http://localhost:11434/v1

# For remote instances:
# LMSTUDIO_BASE_URL=http://192.168.1.100:1234/v1
# OLLAMA_BASE_URL=http://192.168.1.100:11434/v1


# OPENAI / GPT (Optional - for cloud models)
# BASE_URL_GPT=https://api.openai.com/v1
# GPT_API_KEY=sk-your-openai-api-key-here


# ANTHROPIC / CLAUDE (Optional - for cloud models)
# CLAUDE_API_KEY=sk-ant-your-claude-api-key-here


# LLAMA API (Optional - for cloud Llama models)
# BASE_URL_LLAMA=https://api.llama-api.com
# LLAMA_API_KEY=your-llama-api-key-here


# DEEPSEEK (Optional - via Llama API)
# Use same LLAMA_API_KEY and BASE_URL_LLAMA as above


# NOTES
# - Ollama is enabled by default and doesn't need configuration
# - Only set API keys if you want to use cloud models
# - You can mix local (Ollama) and cloud models in the same setup
# - Copy this file to nbf_llm/.env and fill in your keys:
#   cp .env.example nbf_llm/.env
